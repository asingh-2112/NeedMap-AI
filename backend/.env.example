DATABASE_URL=postgresql://postgres.xxxxx:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres
SQLALCHEMY_ECHO=false
RUN_MIGRATIONS=false

# Auth
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_EXPIRE_MINUTES=60

# ML / OCR
# Set to false on CPU-only hosts (e.g. basic cloud VMs)
OCR_USE_GPU=true

# LLM extraction — Portkey gateway (supports Claude, GPT-4, Gemini via one key)
# Get your API key at https://app.portkey.ai/
PORTKEY_API_KEY=your-portkey-api-key
# Model to use for extraction (e.g. claude-sonnet-4-6, gpt-4o-mini, gemini-2.0-flash)
# Portkey automatically routes based on model name
LLM_MODEL=claude-sonnet-4-6

# Voice transcription (Whisper) — optional, needed only for POST /needs/ingest/voice with audio_url
# Uses the same Portkey gateway if PORTKEY_API_KEY is set; or set OPENAI_API_KEY directly
OPENAI_API_KEY=your-openai-api-key-for-whisper
