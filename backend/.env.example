DATABASE_URL=

# Auth
JWT_SECRET_KEY=needmap-ai-secret-key-2026-change-in-prod
JWT_EXPIRE_MINUTES=60

# Migrations (auto-create tables on startup)
RUN_MIGRATIONS=true

# Gemini — Vertex AI (primary) + AI Studio (fallback)
# Vertex AI via service account JSON (preferred — $300 free credit)
# Download from Google Cloud Console → IAM → Service Accounts → Create Key
GOOGLE_APPLICATION_CREDENTIALS=
# AI Studio API key (fallback — free tier available)
# Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# CORS (comma-separated origins, empty = allow all)
ALLOWED_ORIGINS=

# Debug
SQLALCHEMY_ECHO=false